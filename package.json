{
  "name": "desitec-bot-whatsapp",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "dev": "tsx watch src/servidor.ts",
    "worker": "tsx watch src/trabajador.ts",
    "simulador": "tsx watch src/simulador.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/servidor.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/db/migrar.ts",
    "db:seed": "tsx src/shared/db/sembrar.ts",
    "db:actualizar-guion": "tsx scripts/actualizar-guion-handoff.ts"
  },
  "keywords": [],
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "private": true,
  "dependencies": {
    "@google/genai": "^2.31.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
