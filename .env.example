# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/desitec_bot

# Meta WhatsApp Cloud API
# App Secret used to validate X-Hub-Signature-256 (HMAC-SHA256) on webhooks.
META_APP_SECRET=replace-with-meta-app-secret
# Token shared with Meta for the GET verification challenge.
META_VERIFY_TOKEN=replace-with-your-verify-token
# Not used yet (Fase 1). Required only once real sending is implemented.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Safety switch: keep true until real delivery is implemented and tested.
WHATSAPP_DRY_RUN=true

# Maximum accepted size for webhook request bodies, in bytes (default 1 MiB).
WEBHOOK_BODY_LIMIT=1048576

# WhatsApp business accounts registered on startup (seed). JSON array, one entry
# per line. `codigo` is the internal identifier, `idNumeroTelefono` is Meta's
# phone_number_id. Values below are placeholders, never real credentials.
WHATSAPP_ACCOUNTS=[{"codigo":"linea-comercial","nombreComercial":"Linea Comercial","idNumeroTelefono":"000000000000001","telefonoVisible":"+5210000000001","activa":true},{"codigo":"linea-soporte","nombreComercial":"Linea Soporte","idNumeroTelefono":"000000000000002","telefonoVisible":"+5210000000002","activa":true},{"codigo":"linea-postventa","nombreComercial":"Linea Postventa","idNumeroTelefono":"000000000000003","telefonoVisible":"+5210000000003","activa":true}]