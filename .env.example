# Runtime
NODE_ENV=development
PORT=3000
SIMULADOR_PORT=3001
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/desitec_bot

# Messaging provider used for NEW accounts when they do not declare one:
# `meta` (WhatsApp Cloud API) or `360dialog`. Default: 360dialog.
PROVEEDOR_MENSAJERIA_DEFECTO=360dialog

# Meta WhatsApp Cloud API. Required ONLY when at least one account uses the
# `meta` provider (validated at startup).
# App Secret used to validate X-Hub-Signature-256 (HMAC-SHA256) on webhooks.
META_APP_SECRET=replace-with-meta-app-secret
# Token shared with Meta for the GET verification challenge.
META_VERIFY_TOKEN=replace-with-your-verify-token
META_API_VERSION=v21.0

# 360dialog WhatsApp API base URL (WABA v2).
D360_API_BASE_URL=https://waba-v2.360dialog.io

# Per-number credentials, referenced from WHATSAPP_ACCOUNTS via
# `credencialRef`/`webhookSecretRef`. The referenced variable holds the secret
# and is NEVER stored in PostgreSQL. Adjust the suffixes to your account codes.
D360_API_KEY_LINEA_COMERCIAL=

D360_WEBHOOK_SECRET_LINEA_COMERCIAL=a72fa88bf4eba16a44606464f9c51ee02eeb10a1ec626f249854131bad58b8a0

D360_API_KEY_LINEA_SOPORTE=
D360_WEBHOOK_SECRET_LINEA_SOPORTE=
D360_API_KEY_LINEA_POSTVENTA=
D360_WEBHOOK_SECRET_LINEA_POSTVENTA=

# Safety switch: keep true until real delivery is implemented and tested.
WHATSAPP_DRY_RUN=true

# Master switch for the follow-up worker. When false (default), the worker keeps
# running but does NOT process or send follow-ups.
WHATSAPP_SEGUIMIENTOS_ACTIVOS=false

# Attention-window guard (24 h). Set to false ONLY for local/testing sends where
# no recent inbound message exists. Keep true in production.
WHATSAPP_VENTANA_ATENCION_ACTIVA=true

# Suspension window for follow-ups: how often (ms) the worker polls PostgreSQL
# for due follow-ups, and how many it takes per batch. Defaults: 30000 / 50.
WHATSAPP_SEGUIMIENTOS_INTERVALO_MS=30000
WHATSAPP_SEGUIMIENTOS_LOTE=50

# Pause pending follow-ups when the client replies (cancelled with reason
# `respuesta_cliente`). Off by default; enable it explicitly in production.
WHATSAPP_PAUSAR_SEGUIMIENTOS_POR_RESPUESTA=false

# Lead-capture chatbot. Replies to NEW inbound messages using the flow stored in
# `guion_flujo_lead` (seeded by db:seed) and records one lead per conversation.
# On completion the lead is marked `listo_pipedrive`.
WHATSAPP_BOT_ACTIVO=false

# Optional allowlist (comma-separated) of sender numbers that may trigger the bot.
# Empty = every inbound sender. Numbers are compared ignoring +, spaces and the
# Mexican 52/521 prefix, so `4772905770` matches `+52 1 477 290 5770`.
WHATSAPP_BOT_NUMEROS_PERMITIDOS=

# Shared secret for the internal endpoints POST /api/mensajes and
# POST /api/seguimientos (header `x-api-key-interna`). If empty, the endpoints
# are not registered (404).
API_INTERNAL_KEY=

# Maximum accepted size for webhook request bodies, in bytes (default 1 MiB).
WEBHOOK_BODY_LIMIT=1048576

# WhatsApp business accounts registered on startup (seed). JSON array, one entry
# per line. `codigo` is the internal identifier, `idNumeroTelefono` is the
# provider's phone_number_id. `proveedor` selects the adapter (`meta`/`360dialog`);
# `credencialRef`/`webhookSecretRef` name the env variables holding the secrets
# (never stored in PostgreSQL). `tokenAcceso` is kept only for Meta accounts
# during the transition. Values below are placeholders.
WHATSAPP_ACCOUNTS=[{"codigo":"linea-comercial","nombreComercial":"Linea Comercial","idNumeroTelefono":"2657734990991616","telefonoVisible":"+5210000000001","proveedor":"360dialog","credencialRef":"D360_API_KEY_LINEA_COMERCIAL","webhookSecretRef":"D360_WEBHOOK_SECRET_LINEA_COMERCIAL","activa":true},{"codigo":"linea-soporte","nombreComercial":"Linea Soporte","idNumeroTelefono":"000000000000002","telefonoVisible":"+5210000000002","proveedor":"360dialog","credencialRef":"D360_API_KEY_LINEA_SOPORTE","webhookSecretRef":"D360_WEBHOOK_SECRET_LINEA_SOPORTE","activa":true},{"codigo":"linea-postventa","nombreComercial":"Linea Postventa","idNumeroTelefono":"000000000000003","telefonoVisible":"+5210000000003","proveedor":"360dialog","credencialRef":"D360_API_KEY_LINEA_POSTVENTA","webhookSecretRef":"D360_WEBHOOK_SECRET_LINEA_POSTVENTA","activa":false}]

# Modo de respuestas del bot de IA.
# "reglas" -> flujo determinista basado en reglas y guion.
# "gemini" -> respuestas generadas por Gemini AI (requiere GEMINI_API_KEY y numeros permitidos).
WHATSAPP_RESPUESTAS_MODO=reglas

# Configuración de la IA Gemini.
GEMINI_API_KEY=coloca-tu-api-key-aqui
GEMINI_MODEL=gemini-4-argon
GEMINI_TIMEOUT_MS=10000
GEMINI_THINKING_LEVEL=low
GEMINI_HISTORIAL_LIMITE=10
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_INTENTOS=2
GEMINI_MAX_SOLICITUDES_DIA=0
GEMINI_MAX_LONGITUD_RESPUESTA=800